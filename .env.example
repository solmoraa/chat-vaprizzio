# Seguridad: production requiere ambas variables.
APP_ENV=test
ALLOW_PRODUCTION=false
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_PATH=./data/vaprizzio-test.sqlite

# Backend comercial
CATALOG_PROVIDER=fixture
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# OpenClaw / WhatsApp TEST
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=vaprizzio-sales
OPENCLAW_CLI_PATH=openclaw
WHATSAPP_ACCOUNT=
WHATSAPP_TEST_ALLOW_FROM=

# Instagram TEST / Meta
# Con Instagram Login este ID es solo informativo: el backend usa /me para no
# mezclar el ID propio del token con el instagram_business_account.id de Facebook.
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Token generado con el inicio de sesion profesional de @vaprizzio.
META_INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=
# Clave secreta de la app de Instagram. Si queda vacia usa META_APP_SECRET.
META_INSTAGRAM_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Intervencion humana (Telegram inicialmente)
HUMAN_NOTIFICATION_CHANNEL=telegram
# Uno o varios IDs separados por comas.
HUMAN_NOTIFICATION_CHAT_ID=
TELEGRAM_BOT_TOKEN=
INTERNAL_WEBHOOK_SECRET=
TOOL_API_TOKEN=
TOOL_RATE_LIMIT_PER_MINUTE=120

# Operacion
DEBOUNCE_MS=8000
CONVERSATION_IDLE_MINUTES=720
CONVERSATION_RETENTION_DAYS=30
SALE_CONFIRMATION_MODE=disabled
HEALTH_FAILURE_THRESHOLD=3
HEALTH_ALERT_COOLDOWN_MINUTES=30
HEALTH_MONITOR_STATE_FILE=./data/health-monitor-state.json
